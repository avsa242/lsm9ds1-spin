'#include "core.con.click.spin2"                ' uncomment to use the Click board (I2C only)

' Uncomment the four lines below to use SPI
'#ifndef MIKROE_CLICK
'# define LSM9DS1_SPI
'# pragma exportdef(LSM9DS1_SPI)
'#endif

CON

    _clkfreq    = cfg._clkfreq_def
    _xtlfreq    = cfg._xtlfreq

' -- User-modifiable constants
    CLICK_BASE  = 16
' --

OBJ

    cfg:    "boardcfg.p2eval"
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000

#ifndef MIKROE_CLICK
    { modify pin settings in this section for non-MikroE Click LSM9DS1 boards }
    { to use 3-wire SPI, set MOSI and MISO to the same pin }
    sensor: "sensor.imu.9dof.lsm9ds1" | {I2C} SCL=2, SDA=3, I2C_FREQ=400_000, I2C_ADDR=0, ...
                                        {SPI} CS_AG=0, CS_M=1, SCK=2, MOSI=3, MISO=4, ...
                                            SPI_FREQ=1_000_000
#else
    { for MikroE Click boards, set the base pin above (CLICK_BASE) }
    { the MikroE Click board only supports I2C }
    sensor: "sensor.imu.9dof.lsm9ds1" | {I2C} SCL=SCL_PIN, SDA=SDA_PIN, I2C_FREQ=400_000, ...
                                            I2C_ADDR=0
#endif


PUB setup()

    ser.start()
    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"LSM9DS1 driver started")
    else
        ser.strln(@"LSM9DS1 driver failed to start - halting")
        repeat

    sensor.preset_active()

    repeat
        ser.pos_xy(0, 3)
        show_accel_data()
        show_gyro_data()
        show_mag_data()
        if ( ser.getchar_noblock() == "c" )
            cal_accel()
            cal_gyro()
            cal_mag()


#include "acceldemo.common.spin2h"              ' use code common to all accelerometer,
#include "gyrodemo.common.spin2h"               '   gyroscope,
#include "magdemo.common.spin2h"                '   and magnetometer demos.


DAT
